<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Capacitor şablonu Theme.AppCompat.Light + beyaz splash kullanıyordu.
      Çentikli ve uzun ekranda sistem çubuğu / kesik / kenar o beyazı
      gösteriyordu. Pencere, durum ve gezinme çubuğu oyun zemini.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/retro_bg</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/retro_bg</item>
        <item name="android:statusBarColor">@color/retro_bg</item>
        <item name="android:navigationBarColor">@color/retro_bg</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:navigationBarDividerColor">@color/retro_bg</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/retro_bg</item>
        <item name="android:statusBarColor">@color/retro_bg</item>
        <item name="android:navigationBarColor">@color/retro_bg</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/retro_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@color/retro_bg</item>
        <item name="android:statusBarColor">@color/retro_bg</item>
        <item name="android:navigationBarColor">@color/retro_bg</item>
        <item name="android:background">@color/retro_bg</item>
    </style>
</resources>
