{
  "name": "retro-voleybol",
  "private": true,
  "version": "0.1.7",
  "type": "module",
  "description": "Retro Voleybol'na adanmış retro piksel voleybol oyunu",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node tests/kos.mjs",
    "olcum": "node tests/olcum/oran.mjs",
    "olcum:akicilik": "node tests/olcum/akicilik.mjs",
    "olcum:gecikme": "node tests/olcum/gecikme.mjs",
    "olcum:ilerleme": "node tests/olcum/ilerleme.mjs",
    "olcum:top": "node tests/olcum/top.mjs",
    "olcum:ping": "node tests/olcum/ping.mjs",
    "olcum:hissedilen": "node tests/olcum/hissedilen.mjs",
    "olcum:gercek-yol": "node tests/olcum/gercek-yol.mjs",
    "olcum:cevrimici-kare": "node tests/olcum/cevrimici-kare.mjs",
    "olcum:vurus": "node tests/olcum/vurus.mjs",
    "olcum:kare-hizi": "node tests/olcum/kare-hizi.mjs",
    "olcum:toparlanma": "node tests/olcum/toparlanma.mjs",
    "olcum:tampon-tabani": "node tests/olcum/tampon-tabani.mjs",
    "olcum:ekran-hizi": "node tests/olcum/ekran-hizi.mjs",
    "olcum:tasima": "node tests/olcum/tasima.mjs",
    "olcum:yerli": "node tests/olcum/yerli-istemci.mjs",
    "vercel-build": "vite build",
    "build:portal": "node scripts/build-portal.mjs",
    "rele": "node sunucu/index.js",
    "paket": "node scripts/paket-onkontrol.mjs && npm run build && npx cap sync",
    "paket:android": "npm run paket && npx cap open android",
    "e2e:paket": "node tests/e2e/paket.mjs",
    "ikon": "node scripts/ikon-uret.mjs",
    "magaza-gorsel": "node scripts/magaza-gorsel.mjs",
    "generate-video": "node scripts/generate-video.mjs",
    "prepare-remotion": "node scripts/prepare-remotion-assets.mjs",
    "remotion:studio": "remotion studio remotion/index.ts",
    "muzik-uret": "node scripts/muzik-uret.mjs",
    "typecheck:video": "tsc -p tsconfig.json",
    "render:v1": "remotion render remotion/index.ts ReelsOption1 out/option1.mp4",
    "render:v2": "remotion render remotion/index.ts ReelsOption2 out/option2.mp4",
    "render:v3": "remotion render remotion/index.ts ReelsOption3 out/option3.mp4",
    "build:v1": "npm run prepare-remotion && npm run render:v1",
    "build:v2": "npm run prepare-remotion && npm run render:v2",
    "build:v3": "npm run prepare-remotion && npm run render:v3",
    "build:all": "npm run prepare-remotion && npm run render:v1 && npm run render:v2 && npm run render:v3",
    "build-video": "npm run build:v1",
    "store-shots:capture": "node scripts/store-shots-capture.mjs",
    "store-shots:render": "remotion still remotion/index.ts StoreScreenshot1 out/store_screenshot_1.png --image-format=png && remotion still remotion/index.ts StoreScreenshot2 out/store_screenshot_2.png --image-format=png && remotion still remotion/index.ts StoreScreenshot3 out/store_screenshot_3.png --image-format=png && remotion still remotion/index.ts StoreScreenshot4 out/store_screenshot_4.png --image-format=png && remotion still remotion/index.ts StoreScreenshot5 out/store_screenshot_5.png --image-format=png",
    "build:store-shots": "npm run store-shots:capture && npm run store-shots:render",
    "build:icon-1": "remotion still remotion/index.ts AppIcon1 out/icon_flaming_ball.png --image-format=png",
    "build:icon-2": "remotion still remotion/index.ts AppIcon2 out/icon_player_hero.png --image-format=png",
    "build:icon-3": "remotion still remotion/index.ts AppIcon3 out/icon_minimal_court.png --image-format=png",
    "build:icon-4": "remotion still remotion/index.ts AppIcon4 out/icon_arcade_shield.png --image-format=png",
    "build:icons": "npm run build:icon-1 && npm run build:icon-2 && npm run build:icon-3 && npm run build:icon-4 && npm run icons:verify",
    "icons:verify": "node scripts/icon-dogrula.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.2",
    "@remotion/cli": "4.0.536",
    "@remotion/media-utils": "4.0.536",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/react": "18.3.12",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "^24.1.0",
    "playwright": "^1.56.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "5.8.3",
    "vite": "^5.3.1",
    "vitest": "^2.0.5",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=18"
  }
}
