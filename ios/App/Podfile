require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.0'
# Statik bağlama: Capacitor ve Cordova ayrı gömülü framework olmaz.
# Dinamik gömme, exportArchive sırasında bu ürünlere App Store profilini
# yazıp çıkış kodu 70 veriyor.
use_frameworks! :linkage => :static

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCommunityAdmob', :path => '../../node_modules/@capacitor-community/admob'
  pod 'CapacitorApp', :path => '../../node_modules/@capacitor/app'
end

# Çıktısı olmayan [CP] betiklerinde "Based on dependency analysis" kapalı kalsın.
# Xcode aksi halde her derlemede çalışacakları uyarısını basar.
def cp_betiklerini_her_derlemede_calistir(project)
  project.targets.each do |target|
    target.build_phases.each do |phase|
      next unless phase.respond_to?(:name) && phase.respond_to?(:always_out_of_date=)
      next unless phase.name.to_s.start_with?('[CP]')
      outputs = Array(phase.output_paths) + Array(phase.output_file_list_paths)
      next unless outputs.empty?
      phase.always_out_of_date = '1'
    end
  end
end

target 'App' do
  capacitor_pods
  # Google-Mobile-Ads-SDK 11.3.0, User Messaging Platform'u ">= 1.1" diye çeker.
  # UMP 3, eklentinin UMPConsentStatus API'sini kaldırdığı için arşiv
  # çıkış kodu 65 ile düşer. 2.7.0 son sürümdür ve eski adları korur.
  pod 'GoogleUserMessagingPlatform', '2.7.0'
end

post_install do |installer|
  assertDeploymentTarget(installer)
  # Capacitor podspec 13.0 yazar. App hedefiyle aynı taban: iOS 15.
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
  end
  # Pod hedefleri profil aramasın. Uygulama hedefi kendi profilini kullanır.
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      config.build_settings['PROVISIONING_PROFILE_SPECIFIER'] = ''
      config.build_settings['PROVISIONING_PROFILE'] = ''
    end
  end
  cp_betiklerini_her_derlemede_calistir(installer.pods_project)
end

post_integrate do |installer|
  installer.aggregate_targets.map(&:user_project).uniq.each do |project|
    cp_betiklerini_her_derlemede_calistir(project)
    project.save
  end
end
