{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/pitch.pdf",
      "headers": [{ "key": "Content-Type", "value": "application/pdf" }]
    }
  ],
  "rewrites": [
    { "source": "/((?!pitch\\.pdf$|pitch\\.html$).*)", "destination": "/" }
  ]
}
